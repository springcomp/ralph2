{
  "name": "ralph",
  "version": "0.1.0",
  "description": "A deterministic AI coding loop orchestrator.",
  "type": "module",
  "bin": {
    "ralph": "dist/cli/index.js"
  },
  "files": ["dist", "bootstrap", "samples"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:bootstrap": "pnpm build && node scripts/seed-bootstrap.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
